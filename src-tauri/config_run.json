{
  "inbounds": [
    {
      "auto_route": true,
      "inet4_address": "172.19.0.1/30",
      "interface_name": "wintun-game",
      "sniff": true,
      "stack": "system",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
