      "server_port": 443,
      "tag": "proxy",
      "tls": {
        "enabled": true,
        "insecure": true
      },
      "type": "hysteria2",
      "up_mbps": 100
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "proxy",
    "rules": [
      {
        "outbound": "direct",
        "protocol": "dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
